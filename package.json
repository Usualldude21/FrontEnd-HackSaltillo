{
  "name": "zikit-sentinel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:contract": "VITE_DATA_SOURCE=contract vite --mode contract",
    "dev:api": "VITE_DATA_SOURCE=api vite --mode api",
    "demo:jury": "node scripts/start-jury-demo.mjs",
    "build": "tsc -b && vite build",
    "build:api": "tsc -b && VITE_DATA_SOURCE=api vite build --mode api",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.5",
    "eventsource-parser": "3.0.6",
    "gsap": "3.13.0",
    "lucide-react": "0.545.0",
    "msw": "2.11.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "recharts": "3.3.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
